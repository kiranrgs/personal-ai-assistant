# Copy to .env and fill in. Never commit the real .env.

# ── Telegram bot(s) ───────────────────────────────────────────────
# No bot token/allow-list goes here - EVERY Telegram bot (including your
# very first one) is registered through the admin console's Tenants page
# instead (own @BotFather token + own comma-separated allowed chat IDs,
# fully isolated per tenant). See ADMIN_USERNAME/ADMIN_PASSWORD below and
# src/admin_server.py - set those, run the admin console, then add a
# tenant there before starting `python -m src.bot`.

# ── WhatsApp (optional secondary channel, via Twilio WhatsApp sandbox/number) ─
WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_FROM=                 # e.g. whatsapp:+14155238886

# ── Discord (optional secondary channel) ─────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=          # comma-separated channel IDs allowed to use the bot

# ── LLM routing ───────────────────────────────────────────────────────────────
LLM_DEFAULT_PROVIDER=groq             # groq | ollama
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b           # default (small tier)
# Tier pools (same names/format as finance-bot). Desktop users may pick any; Telegram/WhatsApp/Discord: small only.
# GROQ_SMALL_MODEL_POOL=qwen/qwen3.8-27b
# GROQ_MEDIUM_MODEL_POOL=openai/gpt-oss-20b
# GROQ_HIGH_MODEL_POOL=openai/gpt-oss-120b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Supabase (new, separate project) ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # server-side only, never expose to a client

# ── Google (Gmail, Calendar, Drive, Sheets) — supports multiple accounts ─────
# One OAuth client (Desktop app type) from Google Cloud Console, consented per account.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=config/google_client_secret.json
GOOGLE_ACCOUNTS=                      # comma-separated labels, e.g. personal,work
GOOGLE_TOKEN_DIR=config/tokens/google

# ── Microsoft 365 (Outlook mail/calendar via Microsoft Graph) ────────────────
MS_CLIENT_ID=
MS_TENANT_ID=common
MS_ACCOUNTS=                          # comma-separated labels
MS_TOKEN_DIR=config/tokens/ms

# ── iCloud (IMAP mail + CalDAV calendar, use an app-specific password) ───────
ICLOUD_ACCOUNTS=                      # comma-separated labels
# Per label <LABEL>, set: ICLOUD_<LABEL>_EMAIL, ICLOUD_<LABEL>_APP_PASSWORD

# ── Yahoo Mail (IMAP, use an app password) ───────────────────────────────────
YAHOO_ACCOUNTS=                       # comma-separated labels
# Per label <LABEL>, set: YAHOO_<LABEL>_EMAIL, YAHOO_<LABEL>_APP_PASSWORD

# ── Smart home ────────────────────────────────────────────────────────────────
SMARTTHINGS_PAT=                      # Personal Access Token from account.smartthings.com/tokens
NEST_PROJECT_ID=                      # Device Access project ($5 one-time fee)
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=
NEST_REFRESH_TOKEN=
WYZE_EMAIL=
WYZE_PASSWORD=
WYZE_KEY_ID=                         # from Wyze developer portal
WYZE_API_KEY=
HOMEBRIDGE_URL=                      # e.g. http://localhost:8581
HOMEBRIDGE_USERNAME=
HOMEBRIDGE_PASSWORD=
CLAREHOME_BASE_URL=                  # local ClareOne hub address or Clare Fusion endpoint (installer-dependent)
CLAREHOME_API_KEY=
ALADDIN_EMAIL=                       # see src/integrations/smart_home/aladdin_connect.py - verify a client package yourself
ALADDIN_PASSWORD=
IROBOT_ROBOT_IPS=                    # ip:blid:password,ip2:blid2:password2 - get via `python -m roombapy.getpassword <ip>`

# ── Telephony (Twilio, for placing/answering calls) ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_WEBHOOK_BASE_URL=             # public HTTPS URL (e.g. via ngrok/cloudflared) for Twilio callbacks

# ── Twitter/X (requires a paid API tier for read access) ─────────────────────
TWITTER_BEARER_TOKEN=
# Optional OAuth1 user-context (needed to read your REAL following list for
# summarize_followed_twitter_digest - without these, TWITTER_FOLLOWED_HANDLES is used instead):
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_FOLLOWED_HANDLES=             # comma-separated fallback list, e.g. handle1,handle2

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=                     # optional, only needed for search-by-topic

# ── Web research (ticket search / food deals) ────────────────────────────────
SEARCH_API_KEY=                      # e.g. a SERP/Bing/Brave search API key
SEARCH_PROVIDER=bing

# ── Job search (reuses SEARCH_API_KEY above) ─────────────────────────────────
JOB_SEARCH_PORTALS=linkedin.com/jobs,indeed.com,glassdoor.com/job-listing,ziprecruiter.com
JOB_SEARCH_DEFAULT_LOCATION=

# ── Wishlist price monitoring ─────────────────────────────────────────────────
WISHLIST_CHECK_INTERVAL_HOURS=6

# ── Nearby food-delivery deal monitoring ─────────────────────────────────────
FOOD_DEALS_ZIP_CODE=
FOOD_DEALS_CITY=

# ── Morning briefing weather (Open-Meteo, no API key needed) ─────────────────
BRIEFING_LATITUDE=
BRIEFING_LONGITUDE=

# ── Geofencing / household presence webhook ──────────────────────────────────
PRESENCE_WEBHOOK_SECRET=             # shared secret your iPhone Shortcuts automation sends as X-Presence-Secret

# ── Anomaly detection (rate-limit unusually repetitive tool calls) ───────────
ANOMALY_TOOL_CALL_THRESHOLD=15
ANOMALY_WINDOW_MINUTES=5

# ── Admin console (src/admin_server.py) - multi-tenant bots + editing users' ─
# ── config from a browser; leave ADMIN_PASSWORD blank to keep it disabled ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Sibling app integrations on this machine (path depends on your OS/where ─
# ── you cloned them - e.g. C:\GitHub\finance-bot on Windows, ─────────────────
# ── /home/you/finance-bot on Ubuntu, /Users/you/finance-bot on macOS) ────────
FINANCE_BOT_PATH=
PERSONAL_KEY_VAULT_PATH=
# VAULT_ACCOUNT_EMAIL is deliberately NOT set here - it's per-user (the
# email that person signed up with in personal-key-vault, a separate app
# with its own Supabase Auth), so each user links their own via
# `/set VAULT_ACCOUNT_EMAIL you@example.com` in chat (or the admin console's
# Users page) rather than one shared value applying to everyone.

# personal-key-vault's opt-in "Companion apps API" (create a companion user,
# fetch cards/credentials, resolve per-category default cards for automated
# transactions). Off by default and per-user, same pattern as
# VAULT_ACCOUNT_EMAIL above - NOT set here. Each user turns it on (and can
# turn it back off) via `/set VAULT_API_ENABLED true` plus
# `/set VAULT_COMPANION_PORT <port>` / `/set VAULT_COMPANION_TOKEN <token>`
# (from personal-key-vault's Security tab -> "Enable companion API" /
# companion.json on that machine), or the admin console's Users page.
